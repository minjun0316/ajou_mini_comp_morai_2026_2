<launch>
    <node pkg="beginner_tutorials" type="global_path_pub.py" name="read_path_pub"  />
    <node pkg="beginner_tutorials" type="gpsimu_parser.py" name="GPS_IMU_parser"/>
    <node pkg="beginner_tutorials" type="local_path_pub.py" name="path_pub" />    
    <node pkg="beginner_tutorials" type="lattice_planner.py" name="lattice_planner" output="screen"/>
    <node pkg="beginner_tutorials" type="pure_pursuit_pid_velocity_planning.py" name="pure_pursuit_pid_velocity_planning" output="screen">
        <!-- allowed_signal: Green=16, Green_with_left_arrow=32 -->
        <rosparam param="traffic_stop_zones">
          - id: "C1256W000081"
            x_min: 1.0
            x_max: 2.0
            y_min: -45.0
            y_max: -42.0
            z_min: 28.0
            z_max: 29.0
            allowed_signal: 32
          - id: "C1256W000074"
            x_min: -45.0
            x_max: -40.0
            y_min: -17.0
            y_max: -16.0
            z_min: 28.0
            z_max: 29.0
            allowed_signal: 16
        </rosparam>
        <param name="traffic_approach_distance" value="5.0"/>
        <param name="traffic_approach_velocity" value="10.0"/>
    </node>

    <node pkg="beginner_tutorials" type="mgeo_pub.py" name="mgeo_pub"  />
    <node pkg="beginner_tutorials" type="tf_pub.py" name="tf"  />
    <node pkg="rviz" type="rviz" name="rviz" args="-d $(find beginner_tutorials)/rviz/lane_detection_rviz.rviz" />
</launch>
